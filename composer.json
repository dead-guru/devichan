{
  "name": "dead-guru/devichan",
  "description": "devichan imageboard",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/dead-guru/latex2mathml-php.git",
      "no-api": true
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": ">=8.1",
    "ext-fileinfo": ">=8.1",
    "ext-gd": ">=8.1",
    "ext-gettext": "*",
    "ext-imagick": "*",
    "ext-mbstring": ">=8.1",
    "ext-pdo": ">=8.1",
    "bepsvpt/blurhash": "^2.1",
    "dapphp/securimage": "^4.0",
    "dead-guru/latex2mathml-php": "^1.5.1",
    "erusev/parsedown": "^1.8",
    "ezyang/htmlpurifier": "^4.16",
    "geoip/geoip": "^1.17",
    "gettext/gettext": "^1.0",
    "lifo/ip": "^1.1",
    "matthiasmullie/minify": "^1.3",
    "mrclay/jsmin-php": "^2.4",
    "twig/twig": "^2"
  },
  "autoload": {
    "classmap": [
      "inc/"
    ]
  },
  "license": "Tinyboard + vichan",
  "authors": [
    {
      "name": "savetheinternet",
      "homepage": "https://github.com/savetheinternet"
    },
    {
      "name": "czaks",
      "homepage": "https://github.com/czaks"
    },
    {
      "name": "ctrlcctrlv",
      "homepage": "https://github.com/ctrlcctrlv"
    },
    {
      "name": "h00j",
      "homepage": "https://github.com/h00j"
    },
    {
      "name": "assada",
      "homepage": "https://github.com/assada"
    }
  ],
  "require-dev": {
    "codeception/c3": "^2.9",
    "codeception/codeception": "^5.2",
    "codeception/module-asserts": "^3.1",
    "codeception/module-db": "^3.2",
    "codeception/module-phpbrowser": "^3.0",
    "codeception/module-webdriver": "^4.0",
    "phpunit/phpunit": "^10.5",
    "symfony/var-dumper": "^6.2"
  },
  "config": {
    "allow-plugins": {
      "codeception/c3": true
    },
    "sort-packages": true
  }
}
